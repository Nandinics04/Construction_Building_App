# Learn more: https://docs.github.com/en/get-started/git-basics/ignoring-files

# Dependencies (reinstall with npm install)
node_modules/

# Expo / Metro local cache and generated types
.expo/
dist/
web-build/
.turbo/
expo-env.d.ts
.metro-health-check*

# Secrets — keep .env.example in git, never the real keys
.env
.env.*
!.env.example

# Native prebuild output (Expo Go does not need these)
/ios
/android
.kotlin/

# Keystores and signing material
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Logs and debug dumps
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# OS / editor clutter
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
.claude/
.cursor/

# TypeScript
*.tsbuildinfo

# Misc
example
coverage/
