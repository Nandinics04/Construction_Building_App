{
  "expo": {
    "name": "ConneX",
    "slug": "construction-building-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "constructionbuildingapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.connex.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show nearby planners and suppliers.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photos to attach project progress images."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyADgA05KTjo1ow05rVpmiQ9lXBH5naB--k"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "com.connex.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyADgA05KTjo1ow05rVpmiQ9lXBH5naB--k"
        }
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to find nearby planners and suppliers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to attach project progress images."
        }
      ],
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyADgA05KTjo1ow05rVpmiQ9lXBH5naB--k",
          "androidGoogleMapsApiKey": "AIzaSyADgA05KTjo1ow05rVpmiQ9lXBH5naB--k"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
